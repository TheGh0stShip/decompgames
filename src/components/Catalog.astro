---
import GameCard from './GameCard.astro';
import { games, cleanroom, classics, genres, platforms, slug } from '../lib/catalog';
// `only` pre-filters the grid for the crawlable /platform/ pages.
const { only = '', heading = 'Play in your browser' } = Astro.props as { only?: string; heading?: string };
const chips: [string, string][] = [
  ['', 'All'], ['cleanroom', 'Community builds'],
  ...platforms.map(p => [slug(p), p] as [string, string]),
  ...genres.map(g => [slug(g), g] as [string, string]),
];
---
<section class="card" id="catalog" data-only={only}>
  <div class="catalog-head">
    <h1>{heading}</h1>
    <span class="muted" id="gf-count" role="status">{games.length} games</span>
  </div>
  <div id="recent" hidden>
    <p class="muted" style="margin:.75rem 0 0">Continue playing</p>
    <div class="recent-row" id="recent-row"></div>
  </div>
  <input class="gf-search" id="gf-search" type="search" placeholder={`Search ${games.length} games…`} aria-label="Search games" autocomplete="off" />
  <div class="gf-chips" role="group" aria-label="Filter games">
    {chips.map(([value, label]) => <button type="button" class:list={['gf-chip', { 'is-on': value === only }]} data-cat={value} aria-pressed={value === only}>{label}</button>)}
  </div>
  <div class="shelf" data-shelf>
    <div class="shelf-title" style="margin-top:0"><h2>Community builds</h2><a class="muted" href="/clean-room/">Asset provenance</a></div>
    <ul class="poster-grid">{cleanroom.map((game, i) => <GameCard game={game} eager={i < 4} />)}</ul>
  </div>
  <div class="shelf" data-shelf>
    <div class="shelf-title"><h2>Classic projects</h2><span class="muted">Licences and requirements vary by game</span></div>
    <ul class="poster-grid">{classics.map(game => <GameCard game={game} />)}</ul>
  </div>
  <div class="gf-empty" id="gf-empty" hidden>
    <p>No games match.</p>
    <button type="button" class="button" id="gf-reset">Show everything</button>
  </div>
  <p class="muted" style="margin-top:1.25rem">Browse by platform: {platforms.map((p, i) => <Fragment>{i > 0 && ' · '}<a href={`/platform/${slug(p)}/`}>{p}</a></Fragment>)}</p>
</section>
<script>
import { track } from '../lib/track';
const root = document.querySelector<HTMLElement>('#catalog')!;
const search = document.querySelector<HTMLInputElement>('#gf-search')!;
const chips = [...document.querySelectorAll<HTMLButtonElement>('.gf-chip')];
const items = [...document.querySelectorAll<HTMLElement>('.pc-item')];
let cat = new URLSearchParams(location.search).get('c') ?? root.dataset.only ?? '';
function apply() {
  const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
  let count = 0;
  for (const item of items) {
    const show = (!cat || item.dataset.cats!.split('|').includes(cat)) && words.every(w => item.dataset.search!.includes(w));
    item.hidden = !show;
    if (show) count++;
  }
  for (const shelf of document.querySelectorAll<HTMLElement>('[data-shelf]')) shelf.hidden = !shelf.querySelector('.pc-item:not([hidden])');
  for (const chip of chips) { const on = chip.dataset.cat === cat; chip.classList.toggle('is-on', on); chip.setAttribute('aria-pressed', String(on)); }
  document.querySelector('#gf-count')!.textContent = `${count} ${count === 1 ? 'game' : 'games'}`;
  document.querySelector<HTMLElement>('#gf-empty')!.hidden = count > 0;
}
let timer: ReturnType<typeof setTimeout>;
search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => { apply(); if (search.value.trim()) track('search', { search_term: search.value.trim() }); }, 120); });
search.addEventListener('keydown', e => { if (e.key === 'Escape') { search.value = ''; apply(); } });
for (const chip of chips) chip.addEventListener('click', () => { cat = chip.dataset.cat!; apply(); if (cat) track('filter', { category: cat }); });
document.querySelector('#gf-reset')!.addEventListener('click', () => { search.value = ''; cat = ''; apply(); search.focus(); });
document.addEventListener('keydown', e => { if (e.key === '/' && !(e.target instanceof HTMLInputElement)) { e.preventDefault(); search.focus(); } });
apply();
// Continue playing: ids recorded by the players, newest first.
try {
  const recent: string[] = JSON.parse(localStorage.getItem('dg:recent') || '[]');
  const row = document.querySelector('#recent-row')!;
  for (const id of recent.slice(0, 6)) {
    const item = items.find(i => i.dataset.id === id);
    if (!item) continue;
    const a = document.createElement('a');
    a.href = `/games/${id}/`; a.textContent = `▶ ${item.dataset.title}`;
    row.append(a);
  }
  document.querySelector<HTMLElement>('#recent')!.hidden = !row.children.length;
} catch { /* storage unavailable */ }
</script>
