---
import '../styles/site.css';
import '../styles/details.css';
interface Props { title?: string; description?: string; noindex?: boolean; image?: string; }
const {
  title = 'Play decompiled games in your browser',
  description = 'Browse decompilations, source ports, engine recreations and emulated games, with per-game licences, content requirements and controls.',
  noindex = false,
  image = '/og.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-GQ6627GN8H';
const nav = [
  ['/', 'Games', path === '/' || path.startsWith('/games') || path.startsWith('/platform')],
  ['/clean-room/', 'Asset provenance', path.startsWith('/clean-room')],
  ['/guides/', 'Guides', path.startsWith('/guides')],
  ['/updates/', 'Updates', path.startsWith('/updates')],
  ['/about/', 'About', path.startsWith('/about')],
] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} — Decomp Games</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0e0d0b" />
  <meta property="og:site_name" content="Decomp Games" />
  <meta property="og:title" content={`${title} — Decomp Games`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="alternate" type="application/rss+xml" title="Decomp Games updates" href="/feed.xml" />
  {gaId && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        // Automated browsers are kept out of the data.
        if (!navigator.webdriver) gtag('config', gaId);
      </script>
    </Fragment>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a href="/" class="brand" aria-label="Decomp Games home"><span class="brand-chip" aria-hidden="true">{'{ }'}</span>Decomp Games</a>
    <p class="tagline">Decompiled games, rebuilt clean, playable in your browser.</p>
    <nav class="site-nav" aria-label="Main">
      {nav.map(([href, label, current]) => <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>)}
      <a href="https://github.com/andrewnakas/decompgames" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <nav aria-label="Footer">
      <a href="/">Games</a>
      <a href="/clean-room/">Asset provenance</a>
      <a href="/licenses/">Licenses &amp; credits</a>
      <a href="/privacy/">Privacy</a>
      <a href="/contribute/">Contribute</a>
      <a href="https://exebrowser.com/">ExeBrowser</a>
    </nav>
    <small>Independent community project. Game names belong to their respective owners. See each game's licences, content requirements and verification scope.</small>
  </footer>
</body>
</html>
