---
import {existsSync,readFileSync} from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { games, playerUrl, slug, statusLabel } from '../../lib/catalog';
export function getStaticPaths(){return games.map(game=>({params:{slug:game.id},props:{game}}));}
const {game:g}=Astro.props;
const embed=g.mode==='embed';
const scopedSilent=g.id==='cinder-abuse'||g.id==='kiln-super-zzt'||g.id==='beacon-yard'||g.id==='paper-rooms'||g.id==='beacon-relay'||g.id==='vector-duel';
const manifestPath=`public/manifests/${g.id}.json`;
const runtime=existsSync(manifestPath)?JSON.parse(readFileSync(manifestPath,'utf8')):null;
const related=games.filter(x=>x.id!==g.id&&x.shelf===g.shelf&&(x.genre===g.genre||x.platform===g.platform)).slice(0,4);
const tone=g.verification.status==='gameplay-tested'?'good':'warn';
// Controls are stored as "input — action".
const controls=g.controls.map(line=>{const at=line.indexOf(' — ');return at<0?['',line]:[line.slice(0,at),line.slice(at+3)];});
const size=g.downloadMB?`About ${g.downloadMB} MB`:null;
const url=new URL(`/games/${g.id}/`,Astro.site);
const schema=[
 {'@context':'https://schema.org','@type':'VideoGame',name:g.title,description:g.description,genre:g.genre,gamePlatform:'Web browser',url,sameAs:g.source,...(g.image?{image:new URL(g.image,Astro.site)}:{})},
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Games',item:new URL('/',Astro.site)},{'@type':'ListItem',position:2,name:g.platform,item:new URL(`/platform/${slug(g.platform)}/`,Astro.site)},{'@type':'ListItem',position:3,name:g.title,item:url}]},
];
---
<Layout title={`Play ${g.title} in your browser`} description={g.description} image={g.image}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Games</a><span aria-hidden="true">›</span><a href={`/platform/${slug(g.platform)}/`}>{g.platform}</a><span aria-hidden="true">›</span><span>{g.title}</span></nav>
  <section class="card">
    <div class="game-title"><h1>{g.title}</h1><span class:list={['pill',tone]}>{statusLabel(g)}</span></div>
    <p class="game-sub">{g.platform} · {g.year} · {g.genre} · {g.kind}</p>
    <p>{g.description}</p>
    {embed ? (
      <Fragment>
        <div class="stage" id="stage" data-game={g.id} data-url={g.embedUrl} data-launch={g.launch} data-requires={g.requires} data-platform={g.platform} data-shelf={g.shelf}>
          {g.image && <img class="stage-poster" src={g.image} alt="" />}
          <div class="stage-overlay" id="stage-overlay">
            <button type="button" class="play-button" id="play">▶ Play</button>
            <p id="stage-note">{g.launch==='tab'?'Opens in a new tab. ':''}{size?`${size} on first load. `:''}{scopedSilent?'Silent edition; no audio device.':'Sound starts after your first tap or key press in the game.'}</p>
          </div>
          <button type="button" class="stage-close" id="stage-close" aria-label="Close game">✕</button>
        </div>
        <div class="stage-tools">
          <button type="button" class="button" id="fullscreen">Fullscreen</button>
          <button type="button" class="button" id="stop" disabled>Stop</button>
          <a class="button" href={g.embedUrl} target="_blank" rel="noopener">Open in its own tab ↗</a>
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <a class="stage" href={playerUrl(g.id)} style="display:block">
          {g.image && <img class="stage-poster" src={g.image} alt="" />}
          <span class="stage-overlay"><span class="play-button">▶ {g.mode==='files'?'Play with your files':'Play'}</span><span class="muted">{size?`${size}. `:''}{g.assetRequirements}</span></span>
        </a>
      </Fragment>
    )}
    <details class="fold" open>
      <summary>Controls</summary>
      <table class="controls"><tbody>{controls.map(([input,action])=><tr><td>{input&&<kbd>{input}</kbd>}</td><td>{action}</td></tr>)}</tbody></table>
      {embed&&g.platform==='N64'&&!g.touch&&<p class="muted" style="margin:.75rem 0 0">Touch controls for this game are being rolled out; use a controller or keyboard for now.</p>}
    </details>
  </section>
  <section class="card prose">
    <h2 style="margin-top:0">About this build</h2>
    <p>{g.overview}</p>
    <dl class="game-facts">
      <dt>Built from</dt><dd>{g.engine}</dd>
      <dt>Type</dt><dd>{g.kind}</dd>
      <dt>Game files</dt><dd>{g.assetRequirements}</dd>
      <dt>Code licence</dt><dd>{g.engineLicense}</dd>
      <dt>Assets</dt><dd>{g.assetLicense}</dd>
      <dt>Source</dt><dd><a href={g.source} target="_blank" rel="noopener">{g.source.replace('https://github.com/','')} ↗</a></dd>
    </dl>
    <h2>What has been tested</h2>
    <p>{g.verification.scope}</p>
    {g.verification.date&&<p class="muted">Last tested {g.verification.date} in {g.verification.browsers.join(', ')}. Full playthrough: {g.verification.playthrough?'verified':'not verified'}. <a href="/guides/verification/">How games are tested</a>.</p>}
    {embed&&!scopedSilent&&<p class="muted">The build's own test log is in <a href={`${g.source}/blob/main/STATUS.md`} target="_blank" rel="noopener">STATUS.md</a> in its repository.</p>}
    {g.id==='cinder-abuse'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/cinder-abuse-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='kiln-super-zzt'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/kiln-super-zzt-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='beacon-yard'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/beacon-yard-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='paper-rooms'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/paper-rooms-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='beacon-relay'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/beacon-relay-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='vector-duel'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/vector-duel-release.json">dated distribution and gameplay record</a>.</p>}
    {g.id==='skyways'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/open-skyways-campaign-production-test-2026-10-14.json">thirty-road campaign and browser-restart record</a>.</p>}
    {g.id==='supaplex'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/open-paths-campaign-production-test-2026-10-14.json">six-level campaign and browser-restart record</a>.</p>}
    {g.id==='open-cadet'&&<p class="muted">See the <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/open-cadet-contacts-production-test-2026-10-14.json">live native contact record</a>, <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/open-cadet-flippers-production-test-2026-10-14.json">flipper control record</a> and <a href="https://github.com/andrewnakas/decompgames/blob/main/docs/open-cadet-earned-score-production-test.json">earned-score persistence record</a>.</p>}
    {g.limitations.length>0&&<Fragment><h2>Known limitations</h2><ul>{g.limitations.map(l=><li>{l}</li>)}</ul></Fragment>}
    <h2>Saves</h2>
    <p>{g.saveInstructions}</p>
    {runtime&&<Fragment><h2>Build and corresponding source</h2><p>{g.id==='paper-rooms'?'Prepared with':'Compiled with'} {runtime.toolchain} from revision <code>{runtime.sourceRevision}</code>.</p><ul><li><a href={runtime.sourceArchive}>Corresponding source and patches</a></li><li><a href={`/manifests/${g.id}.json`}>Runtime manifest and checksums</a></li><li><a href="https://github.com/andrewnakas/decompgames/tree/main/provenance">Asset sources and licence notices</a></li></ul></Fragment>}
  </section>
  {related.length>0&&<section class="card"><h2>Play next</h2><ul class="poster-grid">{related.map(game=><GameCard game={game}/>)}</ul></section>}
  {schema.map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\\u003c')}/>)}
  {embed&&<script>import '../../player/embed';</script>}
</Layout>
