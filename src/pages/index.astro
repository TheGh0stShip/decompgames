---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog.astro';
import { games } from '../lib/catalog';
const list = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Decomp Games',
  itemListElement: games.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: new URL(`/games/${g.id}/`, Astro.site) })),
};
---
<Layout>
  <Catalog />
  <section class="card prose">
    <h2 style="margin-top:0">What you are playing</h2>
    <p>This collection includes decompilations, source ports, engine recreations, original implementations and emulated games. Each game page describes its runtime, licences, content requirements and test scope. Replacement media does not by itself establish that all game content is independently authored. <a href="/clean-room/">Read about asset provenance</a>.</p>
    <p>Controller and touch support vary by game. Check the controls and requirements on its page before starting.</p>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(list).replace(/</g, '\\u003c')} />
</Layout>
