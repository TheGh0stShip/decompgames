    "license": "MIT for independently authored observer only",
    "source": "// Private test observer: authored MIT, reads state only. Never shipped in the game.\n#include \"TBall.h\"\n#include \"TCollisionComponent.h\"\n#include <emscripten.h>\nstruct CadetContactObservation {\n    TBall* ball; TFlipperEdge* edge;\n    float speed, ax, ay, x, y, boost;\n    int flag, flag1, flag2;\n    CadetContactObservation(TBall* b, TFlipperEdge* e):ball(b),edge(e),speed(b->Speed),ax(b->Acceleration.X),ay(b->Acceleration.Y),x(b->Position.X),y(b->Position.Y),boost(0),flag(e->FlipperFlag),flag1(e->CollisionFlag1),flag2(e->CollisionFlag2){}\n    ~CadetContactObservation(){\n        EM_ASM({\n            var items=window.cadetContacts||(window.cadetContacts=[]);\n            if(items.length<20000)items.push({name:UTF8ToString($0),time:performance.now(),phase:window.cadetPhase||'unknown',before:{speed:$1,ax:$2,ay:$3,x:$4,y:$5},after:{speed:$6,ax:$7,ay:$8,x:$9,y:$10},boost:$11,flag:$12,flag1:$13,flag2:$14});\n        },edge->CollisionComponent->GroupName,speed,ax,ay,x,y,ball->Speed,ball->Acceleration.X,ball->Acceleration.Y,ball->Position.X,ball->Position.Y,boost,flag,flag1,flag2);\n    }\n};",
    "insertions": [
      "Observer definition after the existing include block",
      "CadetContactObservation observation(ball, this); at EdgeCollision entry",
      "observation.boost = boost; before the original boost threshold calculation"
    ],
