  "decisions": [
    {
      "title": "Resident Evil: Code Veronica X",
      "repo": "AshfordFamily/recvx-decomp",
      "classification": "Upstream-reported completed matching PS2 decompilation; matching executable/ISO build, not established native browser runtime",
      "eligible": false,
      "duplicate": false,
      "codeGrant": "MIT declaration copyright 2024\u20132026 AshfordFamily; no separately verified original Capcom or compiled SDK/CRI permission",
      "dependencies": "Selected config names Sony EE SDK libraries plus Metrowerks tooling and CRI headers/compiled source; three gitlinks recorded without fetching their proprietary payloads",
      "blockers": [
        "Original SLUS_201.84 and disc content required",
        "Sony PS2 SDK versions 2.0.0/3.0.3, SDK runtime and CRI permission outside root MIT clearance",
        "Full independently authored content and portable browser renderer/input/scheduler/runtime not established"
      ]
    },
    {
      "title": "Xenogears / Noah",
      "repo": "yaz0r/Noah",
      "classification": "Nonmatching decompilation-derived C++ reimplementation with SPU emulation; not a general console emulator",
      "eligible": false,
      "duplicate": false,
      "codeGrant": "MIT declaration copyright 2024 Noah authors; separately verified whole reconstructed game/content provenance not established",
      "dependencies": "Pinned SDL, bgfx.cmake, SoLoud, ImGui/club and tinyxml2 gitlinks recorded; included SPU source tagged BSD-3-Clause with pSXAuthor/R. Belmont, not root MIT. Full selected/transitive notice closure unverified",
      "blockers": [
        "Disc-based iso/1.bin loader; no independent complete field/battle/world content",
        "Upstream documents missing VM opcodes, collision/battle/world gaps that block normal progression",
        "No verified Emscripten game path; shader generator, embedded battleCursor.bin provenance, runtime dependencies and SDK closure still need audit"
      ]
    },
    {
      "title": "Serial Experiments Lain",
      "repo": "Y0oshi/lain-psx-decompiled",
      "classification": "Upstream-reported matching decompilation plus native C port with PsyCross-derived SDK replacement; no matching/gameplay reproduction here",
      "eligible": false,
      "duplicate": false,
      "codeGrant": "MIT declaration copyright 2026 Y0oshi; no separately verified inherited retail code/table grant",
      "dependencies": "Vendored PsyCross MIT and SDL2 zlib notices inspected separately; native OpenAL Soft LGPL-2.1-or-later notice/docs, with static linkage in release recipe. Additional listed notices and selection/transitive closure not cleared",
      "blockers": [
        "Both original disc dumps required for narrative/media/tables",
        "psx_mem_load reads SLPS_016.03/04 and copies retail text/rodata/data into PSX arena; native function calls do not establish ROM-free bootstrap",
        "No complete independent narrative/content/table/arena package; memory-card-derived icon excluded from independent-content clearance",
        "No verified browser target; native OpenGL/OpenAL/file-dialog/threads and generated assembly-arena adaptation required"
      ]
    }
