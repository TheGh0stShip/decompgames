{
  "name": "decompgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "node scripts/prepare-static.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/verify-intake-distributions.mjs && node scripts/prepare-static.mjs && astro build && node scripts/postbuild.mjs",
    "verify:intake": "node scripts/verify-intake-distributions.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "astro check && node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "fetch:games": "node scripts/fetch-games.mjs",
    "deploy": "wrangler pages deploy dist --project-name decompgames"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  }
}
